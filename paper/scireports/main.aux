\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces KITTI drives 05, 07 and 10: $t_\mathrm  {rel}$ (\%) (mean $\pm $ standard deviation over 3 training seeds) / $r_\mathrm  {rel}$ ($^\circ $ per 100 m). Clean: split of the paper's text, checkpoint selected on held-out drive 08. With 08: checkpoint selected on the test drives, as in the released code. SuMa: lidar-SLAM reference independent of the IMU; against SuMa, $r_\mathrm  {rel}$ is 0.32 for every row with gyroscope rotation. Gate v3 and v4 give identical results here.}}{7}{table.2}\protected@file@percent }
\newlabel{tab:kitti}{{2}{7}{KITTI drives 05, 07 and 10: $t_\mathrm {rel}$ (\%) (mean $\pm $ standard deviation over 3 training seeds) / $r_\mathrm {rel}$ ($^\circ $ per 100 m). Clean: split of the paper's text, checkpoint selected on held-out drive 08. With 08: checkpoint selected on the test drives, as in the released code. SuMa: lidar-SLAM reference independent of the IMU; against SuMa, $r_\mathrm {rel}$ is 0.32 for every row with gyroscope rotation. Gate v3 and v4 give identical results here}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Heading error against distance on KITTI.} Drives 05 (\textbf  {a}), 07 (\textbf  {b}) and 10 (\textbf  {c}). The network heading wanders by 2--7$^\circ $; the gyroscope integrated over the true image intervals stays within about $\pm 0.5^\circ $. The step on drive 05 near 1.13 km lies in a 1.62 s outage of the inertial navigation unit and appears in both curves, so it most likely comes from the ground truth.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:heading}{{3}{7}{\tbf {Heading error against distance on KITTI.} Drives 05 (\tbf {a}), 07 (\tbf {b}) and 10 (\tbf {c}). The network heading wanders by 2--7$^\circ $; the gyroscope integrated over the true image intervals stays within about $\pm 0.5^\circ $. The step on drive 05 near 1.13 km lies in a 1.62 s outage of the inertial navigation unit and appears in both curves, so it most likely comes from the ground truth}{figure.3}{}}
