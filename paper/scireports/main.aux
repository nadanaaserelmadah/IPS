\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {When to measure and when to learn.} \textbf  {a}, Network minus geometric direction error against de-rotated parallax (lines: bin medians; bands: interquartile range). On EuRoC, measuring is better by 50--110$^\circ $; on KITTI the network is better by 0.3--0.5$^\circ $. \textbf  {b}, KITTI network minus accelerometer length error against the condition number of the window; below the gate threshold the accelerometer is better.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:observ}{{4}{10}{\tbf {When to measure and when to learn.} \tbf {a}, Network minus geometric direction error against de-rotated parallax (lines: bin medians; bands: interquartile range). On EuRoC, measuring is better by 50--110$^\circ $; on KITTI the network is better by 0.3--0.5$^\circ $. \tbf {b}, KITTI network minus accelerometer length error against the condition number of the window; below the gate threshold the accelerometer is better}{figure.4}{}}
