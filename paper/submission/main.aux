\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces When to measure and when to learn. (a) Network minus geometric direction error vs de-rotated parallax: on EuRoC measuring is better by 50--110$^\circ $, on KITTI the network is better by 0.3--0.5$^\circ $. (b) KITTI network minus accelerometer length error vs window condition number: below the gate threshold the accelerometer is better.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:observ}{{7}{7}{When to measure and when to learn. (a) Network minus geometric direction error vs de-rotated parallax: on EuRoC measuring is better by 50--110$^\circ $, on KITTI the network is better by 0.3--0.5$^\circ $. (b) KITTI network minus accelerometer length error vs window condition number: below the gate threshold the accelerometer is better}{figure.7}{}}
