\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces KITTI 05/07/10, $t_\mathrm  {rel}$\,\% (mean $\pm $ sd over 3 seeds) / $r_\mathrm  {rel}$. Clean: paper-text split, checkpoint selected on held-out 08. With 08: checkpoint selected on the test drives, as in VIFT's code. SuMa: lidar-SLAM reference independent of the IMU; against SuMa, $r_\mathrm  {rel}$ is 0.32 for every row with gyro rotation.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:kitti}{{II}{4}{KITTI 05/07/10, $t_\mathrm {rel}$\,\% (mean $\pm $ sd over 3 seeds) / $r_\mathrm {rel}$. Clean: paper-text split, checkpoint selected on held-out 08. With 08: checkpoint selected on the test drives, as in VIFT's code. SuMa: lidar-SLAM reference independent of the IMU; against SuMa, $r_\mathrm {rel}$ is 0.32 for every row with gyro rotation}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces KITTI heading error vs distance on 05/07/10. The network heading wanders by 2--7$^\circ $; the gyroscope integrated over the true image intervals stays within about $\pm 0.5^\circ $. The step on 05 near 1.13\,km lies in a 1.62\,s OXTS outage and appears in both, so it most likely comes from the ground truth.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:heading}{{4}{4}{KITTI heading error vs distance on 05/07/10. The network heading wanders by 2--7$^\circ $; the gyroscope integrated over the true image intervals stays within about $\pm 0.5^\circ $. The step on 05 near 1.13\,km lies in a 1.62\,s OXTS outage and appears in both, so it most likely comes from the ground truth}{figure.4}{}}
