\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-E}}The observability gate}{3}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces System architecture. Camera and IMU feed two branches. The learned branch is the frozen base network (frozen encoders and a causal transformer); only its translation direction $\mathbf  {d}_{\mathrm  {net}}$ and length $\ell _{\mathrm  {net}}$ are used. The measurement branch computes the gyro rotation over the true image interval, the two-view translation direction with that rotation known, and the step length from a windowed accelerometer alignment, each with a quality signal (uncertainty, parallax, conditioning or gravity norm, misfit). The observability gate combines them per edge and per component; the online-trust block (v4) estimates how far the network can be trusted from its agreement with confident geometry.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{4}{System architecture. Camera and IMU feed two branches. The learned branch is the frozen base network (frozen encoders and a causal transformer); only its translation direction $\dnet $ and length $\ell _{\mathrm {net}}$ are used. The measurement branch computes the gyro rotation over the true image interval, the two-view translation direction with that rotation known, and the step length from a windowed accelerometer alignment, each with a quality signal (uncertainty, parallax, conditioning or gravity norm, misfit). The observability gate combines them per edge and per component; the online-trust block (v4) estimates how far the network can be trusted from its agreement with confident geometry}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Learned branch. For each edge $k$, frozen VS-VIO encoders map the stacked frame pair and the 11 interpolated IMU samples to a 768-d latent; the base network's causal transformer fuses the last 10 latents and regresses a 6-DoF relative pose. The gate uses only the translation, split into direction and length; the predicted rotation is discarded in favour of the gyroscope. On EuRoC and TUM-VI we use PI-VIFT (dashed, Fig.~\ref {fig:pivift}), whose head differs: it outputs residual corrections. No component is retrained for the gate.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:net}{{3}{4}{Learned branch. For each edge $k$, frozen VS-VIO encoders map the stacked frame pair and the 11 interpolated IMU samples to a 768-d latent; the base network's causal transformer fuses the last 10 latents and regresses a 6-DoF relative pose. The gate uses only the translation, split into direction and length; the predicted rotation is discarded in favour of the gyroscope. On EuRoC and TUM-VI we use PI-VIFT (dashed, Fig.~\ref {fig:pivift}), whose head differs: it outputs residual corrections. No component is retrained for the gate}{figure.3}{}}
